  33          //返回当前按下的按键标号
  34          unsigned char Key_GateState()
  35          {
  36   1          unsigned char KeyNumber = 0;
  37   1          
  38   1          
  39   1          //P3_0 ~ 3是独立按键
  40   1          if(P3_1 == 0){KeyNumber=1;} 
  41   1          if(P3_0 == 0){KeyNumber=2;}
  42   1          if(P3_2 == 0){KeyNumber=3;}
  43   1          if(P3_3 == 0){KeyNumber=4;}
  44   1          
  45   1          return KeyNumber;
  46   1      }
