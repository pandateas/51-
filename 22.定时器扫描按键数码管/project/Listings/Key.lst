  21          //按下按键返回独立按键标号,但是没有添加防抖和松开按键开始计时功能
  22          unsigned char Key(void)
  23          {
  24   1          unsigned char Temp = 0;
  25   1          Temp = Key_KeyNumber;
  26   1          Key_KeyNumber = 0;
