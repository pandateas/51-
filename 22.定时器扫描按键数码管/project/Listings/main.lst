  64          void Sec_Loop(void)     //时间的循环
  65          {
  66   1          if(runflag)         //判断当前是否是时钟模式,是就进入时间判断,否则跳出函数
  67   1          {   
  68   2              MinSec ++;
  69   2              if(MinSec>=100)
  70   2              {
  71   3                  MinSec = 0;
  72   3                  Sec++;            
  73   3                  if(Sec>=60)
  74   3                  {
  75   4                      Sec = 0;
  76   4                     Min++; 
  77   4                  }            
  78   3                  if(Min >= 60)
  79   3                  {  
  80   4                     Min = 0;                
  81   4                  }             
  82   3              }
  83   2          }
  84   1          
  85   1      }
