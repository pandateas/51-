line level    source

   1          //初始化定时器,开始计时
   2          //计时满后跳转到 main 中的 interrupt 1 函数
   3          //随后执行完interrupt 1 的指令后返回继续计时
   4          //执行完一次 Timer0_Init 大约是 1ms
   5          
   6          #include <REGX52.H>
   7          
   8          void Timer0_Init()//@1ms
   9          {
  10   1          //TMOD = 0x01;//0000 0001//当要使用两个定时器时这样写不行
  11   1          
  12   1          TMOD &= 0xF0;//清零定时器0模式位，不影响定时器2
  13   1          TMOD |= 0x01;//设置定时器0为模式1（16位定时器/计数器）
  14   1          
  15   1          TF0 = 0;//清除定时器0溢出标志
  16   1                  //Timer OverFlow//溢出标志位，需要手动清零
  17   1          
  18   1          TR0 = 1;//Timer_Run//定时器启动开关，开启才能使用
  19   1          
  20   1          // 1ms 定时初值 晶振11.0592MHz 正确值：65536-1000=64536
  21   1          TH0 = 64536 / 256;//取出高八位
  22   1          TL0 = 64536 % 256;//取出低八位
  23   1          //公式:初始时间 / 256
  24   1          //     初始时间 % 256
  25   1          //TH0和TL0两个相互配合完成计时的过程
  26   1          
  27   1          ET0 = 1;//Enable Timer0 Interrupt//定时器0中断使能
  28   1          //定时器0中断开关，开启后计数满会执行中断                               
  29   1          //当ET0 = 0时就算定时器溢出了也不会响应中断
  30   1          
  31   1          EA = 1;//Enable All Interrupts
  32   1          //总开关，允许所有的中断
  33   1          
  34   1          PT0 = 0;//Priority Timer0
  35   1          //设置定时器0的中断优先级默认位 低优先级
  36   1      }
  37          
  38          /*
  39          //定时器0中断服务函数
  40          void Timer0_Routine()interrupt 1
  41          {
  42              static unsigned int T0Count;
  43              int Sec = 0,Min = 0,Hour = 0;
  44              // 重装1ms定时初值
  45              TH0 = 64536 / 256;
  46              TL0 = 64536 % 256;
  47              TF0 = 0;
  48              T0Count ++;   
  49              if(T0Count >= 1000)//设定1000ms=1秒
  50              {
  51                  T0Count = 0;//清零计数器
  52                  Sec++;
  53                  if(Sec >= 60) {Sec = 0;Min ++;}
  54                  if(Min >= 60) {Min = 0;Hour ++;}
